{
  "name": "openai-agents-scavio",
  "version": "0.6.2",
  "description": "198 Scavio tools for the OpenAI Agents SDK: real-time search over 33 platforms (Google, YouTube, Amazon, Walmart, eBay, Target, HEB, Kroger, Zillow, Booking.com, Indeed, SEC EDGAR, G2, Meta Ad Library and more), URL extract, and website map, crawl and batch extract",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "openai",
    "openai-agents",
    "agents",
    "scavio",
    "web-search",
    "serp",
    "tools",
    "web-scraping",
    "url-extract",
    "web-crawler",
    "website-crawler",
    "sitemap",
    "tavily-alternative"
  ],
  "license": "MIT",
  "author": "Scavio <support@scavio.dev>",
  "homepage": "https://scavio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scavio-ai/openai-agents-scavio-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "scavio": "^0.28.1"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.12.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@openai/agents": "^0.12.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "zod": "^4.0.0"
  }
}
